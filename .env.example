# .env.example
# ================================================
# Variables de Entorno para AGNUX
# Copia este archivo a .env y actualiza los valores según tu configuración
# ================================================

# ⚡ PROVEEDOR DE IA
# Opciones: local (RECOMENDADO), gemini, openai
# - local: Usa Ollama en tu máquina (sin depender de APIs externas)
# - gemini: Usa Google Gemini (requiere GEMINI_API_KEY)
# - openai: Usa OpenAI (requiere OPENAI_API_KEY)
AGNUX_IA_PROVIDER=local

# 🧠 MODELO A USAR
# Para Ollama local, debes haber ejecutado: ollama pull <modelo>
# Modelos recomendados:
#   - qwen2.5:1.5b (rápido, eficiente, RECOMENDADO)
#   - mistral (mejor calidad, más recursos)
#   - neural-chat (optimizado para conversación)
#   - llama2 (genérico)
AGNUX_ACTIVE_MODEL=qwen2.5:1.5b

# 🌐 URL DEL SERVIDOR OLLAMA (solo se usa si AGNUX_IA_PROVIDER=local)
# Por defecto Ollama corre en: http://127.0.0.1:11434
# Si instalaste Ollama en otra máquina, cambia la IP
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 🌐 SOLO PARA GEMINI (si AGNUX_IA_PROVIDER=gemini)
# Obtén tu API Key en: https://makersuite.google.com/app/apikey
# AGNUX automáticamente replica a Ollama si Gemini falla
GEMINI_API_KEY=

# 🔑 SOLO PARA OPENAI (si AGNUX_IA_PROVIDER=openai)
# Formato: sk-...
# Obtén tu API Key en: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=

# 🔧 CONFIGURACIÓN DEL SERVIDOR BACKEND
# Puerto donde corre FastAPI
BACKEND_PORT=8000
# Host (0.0.0.0 para aceptar conexiones externas, 127.0.0.1 solo local)
BACKEND_HOST=127.0.0.1

# 🎨 CONFIGURACIÓN DEL FRONTEND
# Puerto donde corre Angular
FRONTEND_PORT=4200

# 🛡️ SEGURIDAD
# Permite comandos destructivos (apagar, reiniciar)
# Valores: true, false
ALLOW_DESTRUCTIVE_COMMANDS=false

# 📊 LOGGING
# Niveles: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
