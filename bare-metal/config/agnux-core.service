[Unit]
Description=AGNUX OS v2.0 - Inteligencia Artificial & Orquestador Core
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/agnux/backend

# Read environment configurations from dotenv
EnvironmentFile=-/opt/agnux/backend/.env

# Launches the FastAPI server via its virtual environment python executable
ExecStart=/opt/agnux/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
